<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Per-monitor DPI awareness, so the window stays sharp when the laptop and TV use different scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shown by Windows for the .exe; tools/make-icon.ps1 draws it. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The installer's version comes from here too. -->
    <Version>1.1.0</Version>
    <Product>CouchShell</Product>
    <Company>Vaasu Jindal</Company>
    <Copyright>Copyright (c) 2026 Vaasu Jindal</Copyright>
    <!-- The interface is in English, so the framework's other languages would only add size. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests check the struct layouts that Win32 depends on. -->
    <InternalsVisibleTo Include="CouchShell.Tests" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Sounds\*.wav" />
    <!-- Copied next to the program, where it can be edited without recompiling. -->
    <Content Include="..\..\config\apps.json" Link="config\apps.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

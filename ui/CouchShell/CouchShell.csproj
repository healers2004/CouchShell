<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Per-monitor DPI awareness, so the window stays sharp when the laptop and TV use different scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied next to the program, where it can be edited without recompiling. -->
    <Content Include="..\..\config\apps.json" Link="config\apps.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

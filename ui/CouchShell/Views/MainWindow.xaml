<!-- Borderless fullscreen window: no title bar, can't be resized, fills the screen. -->
<Window x:Class="CouchShell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CouchShell.Views"
        Title="CouchShell"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#101018">

    <!-- Arrow keys are handled in code, on the same path as the controller. Enter is handled by the
         focused button itself. These work wherever focus is. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding VolumeDownCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Key="M" Command="{Binding MuteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <views:InverseBooleanConverter x:Key="Inverse" />

        <!-- Shared look: a solid highlight on keyboard focus, readable from the couch. -->
        <ControlTemplate x:Key="FocusableCard" TargetType="Button">
            <Border x:Name="Highlight" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"
                    BorderThickness="4" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Highlight" Property="Background" Value="#3A6FF7" />
                    <Setter TargetName="Highlight" Property="BorderBrush" Value="White" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FocusableCard}" />
            <!-- Hide WPF's default dotted focus box; the template is the focus indicator. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#D8D8E4" />
        </Style>

        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B0B0C0" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="28,12" />
        </Style>

        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="#20202E" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="220" />
            <Setter Property="Margin" Value="0,0,24,24" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="#20202E" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Layout is designed on a fixed 1920x1080 canvas; Viewbox scales it to fit
         any resolution (1080p, 4K) and any Windows scaling setting. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Screen tabs and connection status. Disabled behind the confirm dialog, so focus can't leave it. -->
            <DockPanel Margin="72,48,72,24" IsEnabled="{Binding IsConfirmOpen, Converter={StaticResource Inverse}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="20" Height="20" Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E05555" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CC38A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="26" Foreground="#B0B0C0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tab" Content="{Binding Name}" Tag="{Binding FocusKey}" Command="{Binding Command}"
                                    Style="{StaticResource TabButton}" />
                            <DataTemplate.Triggers>
                                <!-- The open screen's tab stays visibly marked, even without focus. -->
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="#2C2C40" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Rows of tiles. WPF scrolls a focused tile into view. -->
            <ScrollViewer Grid.Row="1" Margin="72,0,48,0" Focusable="False" VerticalScrollBarVisibility="Hidden"
                          IsEnabled="{Binding IsConfirmOpen, Converter={StaticResource Inverse}}">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" FontSize="32" Foreground="#B0B0C0" Margin="4,0,0,16" />
                                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Key}" Command="{Binding Command}" Style="{StaticResource TileButton}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Image Source="{Binding Image, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                    <StackPanel VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding Title}" FontSize="34" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="24" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- A short message for the user, e.g. why a launch failed. -->
            <TextBlock Grid.Row="2" Text="{Binding Message}" FontSize="32" Foreground="#FFD27A" Margin="76,12,76,40" TextWrapping="Wrap" />

            <!-- Volume overlay. -->
            <Border Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,96"
                    Background="#E0202030" CornerRadius="16" Padding="40,24" Width="640"
                    Visibility="{Binding IsVolumeVisible, Converter={StaticResource VisibleWhenTrue}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontSize="36" Foreground="White" Margin="24,0,0,0" Width="110" TextAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding VolumePercent, StringFormat={}{0}%}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Text" Value="Muted" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=OneWay}" Height="20" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Confirmation step for power actions. -->
            <Grid Grid.RowSpan="3" Background="#C0000000" Visibility="{Binding IsConfirmOpen, Converter={StaticResource VisibleWhenTrue}}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20202E" CornerRadius="16" Padding="72,56">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmText}" FontSize="44" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Yes" Tag="confirm:yes" Command="{Binding ConfirmYesCommand}" Style="{StaticResource ConfirmButton}" />
                            <Button Content="No" Tag="confirm:no" Command="{Binding ConfirmNoCommand}" Style="{StaticResource ConfirmButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>

<!-- Borderless fullscreen window: no title bar, can't be resized, fills the screen. -->
<Window x:Class="CouchShell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CouchShell.Views"
        xmlns:vm="clr-namespace:CouchShell.ViewModels"
        x:Name="Root"
        Title="CouchShell"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Background="#0D0E11"
        Foreground="#F2F3F5">

    <!-- Arrow keys are handled in code, on the same path as the controller. Enter is handled by the
         focused button itself. These work wherever focus is. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding VolumeDownCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Key="M" Command="{Binding MuteCommand}" />
        <KeyBinding Key="G" Command="{Binding GuideCommand}" />
        <KeyBinding Key="Apps" Command="{Binding GuideCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <views:CollapsedWhenTrueConverter x:Key="CollapsedWhenTrue" />
        <views:InverseBooleanConverter x:Key="Inverse" />
        <views:NullToCollapsedConverter x:Key="CollapsedWhenNull" />
        <views:EqualsConverter x:Key="AreEqual" />

        <!-- Colours. Charcoal, white and grey, with one accent: green, for what's selected or active. -->
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A4A9B3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#17191D" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#1F2228" />
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#262930" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#30333B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#107C10" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#3DBA3D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFC86B" />
        <SolidColorBrush x:Key="FocusTextBrush" Color="#0D0E11" />
        <Color x:Key="BackgroundColor">#0D0E11</Color>
        <Color x:Key="BackgroundSoftColor">#B30D0E11</Color>
        <Color x:Key="BackgroundClearColor">#000D0E11</Color>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- The same shapes as tools/make-icon.ps1. -->
        <ControlTemplate x:Key="Logo">
            <Viewbox>
                <Canvas Width="256" Height="256">
                    <Rectangle Width="256" Height="256" RadiusX="56" RadiusY="56" Fill="#15171C" />
                    <Rectangle Canvas.Left="46" Canvas.Top="58" Width="164" Height="114" RadiusX="20" RadiusY="20" Stroke="White" StrokeThickness="14" />
                    <Path Data="M100,200 H156" Stroke="White" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Fill="#3DBA3D" Data="M100,98 H156 A26,26 0 0 1 181,131 L176,146 A11,11 0 0 1 157,149 L150,139 H106 L99,149 A11,11 0 0 1 80,146 L75,131 A26,26 0 0 1 100,98 Z" />
                    <Rectangle Canvas.Left="92" Canvas.Top="114" Width="6" Height="18" RadiusX="2" RadiusY="2" Fill="#15171C" />
                    <Rectangle Canvas.Left="86" Canvas.Top="120" Width="18" Height="6" RadiusX="2" RadiusY="2" Fill="#15171C" />
                    <Ellipse Canvas.Left="155.5" Canvas.Top="111.5" Width="9" Height="9" Fill="#15171C" />
                    <Ellipse Canvas.Left="165.5" Canvas.Top="121.5" Width="9" Height="9" Fill="#15171C" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- Fades content in when a screen opens or the preview changes. -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MotionDuration}" />
        </Storyboard>

        <!-- A tab: plain text. The open screen's tab is underlined in green; focus is solid white,
             readable from across the room. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#C3C7CF" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- On the border, not the button: the open tab sets the button's own
                                 Foreground, which would win over a trigger here. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="White" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{StaticResource FocusTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yes and No in the confirmation dialog. -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource FocusTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A key on the Search screen's keyboard. -->
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" Background="#E6262930" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource FocusTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tile: picture on top, title underneath. On focus the picture grows a little and gains
             a thick white outline, and the title brightens. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="Frame" Width="360">
                            <Border x:Name="Card" Height="202" CornerRadius="4" Background="{Binding Accent}"
                                    BorderThickness="5" BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Scale" />
                                </Border.RenderTransform>
                                <ContentPresenter />
                            </Border>
                            <TextBlock x:Name="Caption" Text="{Binding Title}" FontSize="24" Margin="2,14,2,0"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="20" Margin="2,2,2,0" Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Subtitle, Converter={StaticResource CollapsedWhenNull}}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Caption" Property="Foreground" Value="White" />
                                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionDuration}" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionDuration}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- What a tile shows: the first of its artwork, icon, brand logo, glyph or first letter. -->
        <DataTemplate x:Key="TileContent">
            <Button Tag="{Binding Key}" Command="{Binding Command}" Style="{StaticResource TileButton}"
                    AutomationProperties.Name="{Binding Title}">
                <Grid ClipToBounds="True">
                    <Image Source="{Binding Image, TargetNullValue={x:Null}}" Stretch="UniformToFill"
                           Visibility="{Binding Image, Converter={StaticResource CollapsedWhenNull}}" />
                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}}" Width="104" Height="104"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IconPath, Converter={StaticResource CollapsedWhenNull}}" />
                    <Path Data="{Binding LogoPath}" Fill="{Binding LogoColor}" Stretch="Uniform" Width="96" Height="96"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding LogoPath, Converter={StaticResource CollapsedWhenNull}}" />
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="60" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Glyph, Converter={StaticResource CollapsedWhenNull}}" />
                    <TextBlock Text="{Binding Monogram}" FontSize="88" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Monogram, Converter={StaticResource CollapsedWhenNull}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A section in the list on the left of Games and Settings. The one showing has a green bar. -->
        <Style x:Key="SectionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#C3C7CF" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4">
                            <Grid>
                                <Rectangle x:Name="Bar" Width="5" RadiusX="2.5" RadiusY="2.5" Margin="0,16" HorizontalAlignment="Left"
                                           Fill="{StaticResource AccentBrightBrush}" Visibility="Hidden" />
                                <ContentPresenter Margin="28,0,22,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AreEqual}">
                                        <Binding Path="Title" />
                                        <Binding Path="DataContext.SelectedSection" ElementName="Root" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource FocusTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One setting in the Settings pane: name and explanation, its value on the right. -->
        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Margin" Value="5,5,5,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{StaticResource SurfaceBrush}" CornerRadius="4" MinHeight="96" Padding="30,14"
                                BorderThickness="5" BorderBrush="Transparent">
                            <DockPanel>
                                <Border x:Name="Value" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="4" Padding="16,6"
                                        Background="Transparent" Visibility="{Binding Subtitle, Converter={StaticResource CollapsedWhenNull}}">
                                    <TextBlock x:Name="ValueText" Text="{Binding Subtitle}" FontSize="23" Foreground="#D5D8DE" />
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="28"
                                           VerticalAlignment="Center" Margin="0,0,24,0" Foreground="#C3C7CF"
                                           Visibility="{Binding Glyph, Converter={StaticResource CollapsedWhenNull}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="26" />
                                    <TextBlock Text="{Binding Description}" FontSize="20" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding Description, Converter={StaticResource CollapsedWhenNull}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Subtitle}" Value="Selected">
                                <Setter TargetName="Value" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ValueText" Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line in the Start menu. -->
        <Style x:Key="GuideButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" Height="76" Padding="52,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           VerticalAlignment="Center" Width="50" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="23" VerticalAlignment="Center" Margin="18,0,0,0"
                                           Opacity="0.75" Visibility="{Binding Value, Converter={StaticResource CollapsedWhenNull}}" />
                                <ProgressBar DockPanel.Dock="Right" Width="200" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                             Value="{Binding DataContext.VolumePercent, ElementName=Root, Mode=OneWay}" BorderThickness="0"
                                             Foreground="{StaticResource AccentBrush}" Background="#4DFFFFFF"
                                             Visibility="{Binding IsSlider, Converter={StaticResource VisibleWhenTrue}}" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#F2F3F5" />
                                <Setter Property="Foreground" Value="{StaticResource FocusTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The screen behind the menu and dialogs fades back. Fading the screen itself, rather than
             laying a dark sheet over it, keeps bright artwork from speckling through. -->
        <Style x:Key="FadesBehindMenus" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBackgroundEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Button hints along the bottom, in the controller's own button colours. -->
        <Style x:Key="HintBadge" TargetType="Border">
            <Setter Property="Background" Value="#D5D8DE" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="30,0,10,0" />
        </Style>
        <Style x:Key="HintBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111214" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#D5D8DE" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The focused tile's artwork fills the screen, darkened on the left and at the bottom so
             text stays readable over any picture. Games and Settings have a plain background. -->
        <Grid Visibility="{Binding IsSectionScreen, Converter={StaticResource CollapsedWhenTrue}}" Style="{StaticResource FadesBehindMenus}">
            <Image Stretch="UniformToFill" VerticalAlignment="Top"
                   Source="{Binding FocusedTile.Backdrop, TargetNullValue={x:Null}, NotifyOnTargetUpdated=True}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F00D0E11" Offset="0" />
                        <GradientStop Color="{StaticResource BackgroundSoftColor}" Offset="0.34" />
                        <GradientStop Color="#1A0D0E11" Offset="0.7" />
                        <GradientStop Color="{StaticResource BackgroundClearColor}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#800D0E11" Offset="0" />
                        <GradientStop Color="{StaticResource BackgroundClearColor}" Offset="0.22" />
                        <GradientStop Color="{StaticResource BackgroundClearColor}" Offset="0.4" />
                        <GradientStop Color="{StaticResource BackgroundSoftColor}" Offset="0.62" />
                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0.85" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Layout is designed on a fixed 1920x1080 canvas; Viewbox scales it to fit
             any resolution (1080p, 4K) and any Windows scaling setting. -->
        <Viewbox Stretch="Uniform" Style="{StaticResource FadesBehindMenus}">
            <Grid Width="1920" Height="1080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="400" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: logo, tabs, then the clock. Connection trouble shows only when there is
                     some. Disabled behind the menu and dialogs, so focus can't leave them. -->
                <DockPanel Margin="78,40,96,0" IsEnabled="{Binding IsBackgroundEnabled}">
                    <Control DockPanel.Dock="Left" Template="{StaticResource Logo}" Width="46" Height="46" Margin="18,0,22,0" VerticalAlignment="Center" Focusable="False" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Not connected" FontSize="22" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,28,0"
                                   Visibility="{Binding IsConnected, Converter={StaticResource CollapsedWhenTrue}}" />
                        <TextBlock x:Name="Clock" FontSize="28" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,0">
                                    <Button x:Name="Tab" Tag="{Binding FocusKey}" Command="{Binding Command}" Content="{Binding Name}"
                                            Style="{StaticResource TabButton}" AutomationProperties.Name="{Binding Name}" />
                                    <!-- Marks the open screen's tab by more than colour alone. -->
                                    <Rectangle x:Name="CurrentBar" Height="4" RadiusX="2" RadiusY="2" Margin="18,0,18,-10" VerticalAlignment="Bottom"
                                               Fill="{StaticResource AccentBrightBrush}" Visibility="Hidden" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="CurrentBar" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Tab" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Preview: what the focused tile is. A game's own logo when it has one, otherwise its name. -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="96,0,96,30"
                            Visibility="{Binding IsSectionScreen, Converter={StaticResource CollapsedWhenTrue}}">
                    <Grid HorizontalAlignment="Left">
                        <Image Source="{Binding FocusedTile.TitleImage, TargetNullValue={x:Null}, NotifyOnTargetUpdated=True}"
                               MaxWidth="560" MaxHeight="190" Stretch="Uniform" HorizontalAlignment="Left"
                               Visibility="{Binding FocusedTile.TitleImage, Converter={StaticResource CollapsedWhenNull}}">
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                        <TextBlock Text="{Binding FocusedTile.Title, NotifyOnTargetUpdated=True}" FontSize="68" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FocusedTile.TitleImage, Converter={StaticResource CollapsedWhenNull}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding FocusedTile.Description}" FontSize="24" Foreground="#C3C7CF" Margin="2,14,0,0" />
                    <Border HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="26,0" Height="56" Margin="0,22,0,0"
                            Visibility="{Binding FocusedTile.ActionLabel, Converter={StaticResource CollapsedWhenNull}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M0,0 L14,8 L0,16 Z" Fill="White" Width="14" Height="16" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FocusedTile.ActionLabel}" FontSize="23" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Rows of tiles. The vertical scroller moves between rows; each row scrolls sideways
                     on its own. Margins leave room for the focused tile's growth. -->
                <!-- Tiles fade out at the bottom instead of being cut off. A mask stretches over what its
                     element draws, so this Grid's background is what makes it span the whole area. -->
                <Grid Grid.Row="2" Background="Transparent" Visibility="{Binding IsSectionScreen, Converter={StaticResource CollapsedWhenTrue}}">
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.94" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <ScrollViewer x:Name="TileScroller" Focusable="False" VerticalScrollBarVisibility="Hidden"
                                  IsEnabled="{Binding IsBackgroundEnabled}">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" RequestBringIntoView="OnTileBringIntoView">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,22">
                                        <StackPanel.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                            </EventTrigger>
                                        </StackPanel.Triggers>
                                        <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" Margin="96,0,0,2" />
                                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="92,14,64,6"
                                                          ItemTemplate="{StaticResource TileContent}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Games and Settings: sections on the left, the chosen one's contents on the right. -->
                <Grid Grid.Row="1" Grid.RowSpan="2" Margin="96,56,64,0" IsEnabled="{Binding IsBackgroundEnabled}"
                      Visibility="{Binding IsSectionScreen, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="38" FontWeight="SemiBold" Margin="2,0,0,30">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Settings" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGamesScreen}" Value="True">
                                            <Setter Property="Text" Value="My games" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding FocusKey}" Style="{StaticResource SectionButton}" AutomationProperties.Name="{Binding Title}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="22" Opacity="0.6" VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.IsGamesScreen, ElementName=Root, Converter={StaticResource VisibleWhenTrue}}" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" Margin="40,0,0,0" Focusable="False" VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSection}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="6,14,0,22" />
                            <!-- Games: a grid of tiles. -->
                            <ItemsControl ItemsSource="{Binding SectionTiles}" Focusable="False" Margin="4,8,0,0"
                                          Visibility="{Binding IsGamesScreen, Converter={StaticResource VisibleWhenTrue}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TileContent}" Margin="0,0,0,34" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Settings: a list of options. -->
                            <ItemsControl ItemsSource="{Binding SectionTiles}" Focusable="False" Width="1060" HorizontalAlignment="Left"
                                          Visibility="{Binding IsSettingsScreen, Converter={StaticResource VisibleWhenTrue}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Key}" Command="{Binding Command}" Style="{StaticResource OptionButton}"
                                                AutomationProperties.Name="{Binding Title}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Shown instead of tiles when a screen has none. -->
                <TextBlock Grid.Row="2" Text="{Binding EmptyText}" FontSize="36" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- The Search screen's keyboard. Its keys are ordinary focusable buttons, so moving
                     between them and the results works like moving between tiles. -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding SearchKeys}" Focusable="False" HorizontalAlignment="Center" Margin="0,0,0,12"
                              IsEnabled="{Binding IsBackgroundEnabled}"
                              Visibility="{Binding IsSearchScreen, Converter={StaticResource VisibleWhenTrue}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" Focusable="False" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding FocusKey}" Command="{Binding Command}" Content="{Binding Label}" Width="{Binding Width}"
                                                Style="{StaticResource KeyButton}" AutomationProperties.Name="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer: a message on the left when there is one, button hints on the right. -->
                <DockPanel Grid.Row="4" Margin="96,4,96,34" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource HintBadge}" Background="#5EC45E">
                            <TextBlock Text="A" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Select" Style="{StaticResource HintLabel}" />
                        <Border Style="{StaticResource HintBadge}" Background="#E05252">
                            <TextBlock Text="B" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Back" Style="{StaticResource HintLabel}" />
                        <Border Style="{StaticResource HintBadge}">
                            <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="13" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Menu" Style="{StaticResource HintLabel}" />
                        <Border Style="{StaticResource HintBadge}" CornerRadius="4">
                            <TextBlock Text="LB  RB" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Volume" Style="{StaticResource HintLabel}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="22,10"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Visibility="{Binding Message, Converter={StaticResource CollapsedWhenNull}}">
                        <TextBlock Text="{Binding Message}" FontSize="24" TextWrapping="Wrap" />
                    </Border>
                </DockPanel>

                <!-- Volume overlay. -->
                <Border Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110"
                        Background="#F217191D" CornerRadius="6" Padding="36,24" Width="680"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                        Visibility="{Binding IsVolumeVisible, Converter={StaticResource VisibleWhenTrue}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="36" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static vm:Glyphs.VolumeUp}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="{x:Static vm:Glyphs.Mute}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" FontSize="30" FontWeight="SemiBold" Margin="24,0,0,0" Width="110" TextAlignment="Right" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding VolumePercent, StringFormat={}{0}%}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="Muted" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=OneWay}" Height="8" VerticalAlignment="Center"
                                     Foreground="{StaticResource AccentBrightBrush}" Background="{StaticResource SubtleSurfaceBrush}" BorderThickness="0" />
                    </DockPanel>
                </Border>
            </Grid>
        </Viewbox>

        <!-- The Start menu: slides in from the left over whatever screen is open. -->
        <Grid Visibility="{Binding IsGuideOpen, Converter={StaticResource VisibleWhenTrue}}">
            <!-- Scaled to the screen's height, so the panel reaches top and bottom on any shape of screen. -->
            <Border HorizontalAlignment="Left" Background="#17191D" BorderBrush="#2B2E35" BorderThickness="0,0,1,0">
                <!-- Fades back too, while a confirmation from it is open. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConfirmOpen}" Value="True">
                                <Setter Property="Opacity" Value="0.3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                <Grid Width="640" Height="1080">
                    <Border IsEnabled="{Binding IsConfirmOpen, Converter={StaticResource Inverse}}">
                        <StackPanel Margin="0,64,0,0">
                            <DockPanel Margin="52,0,52,30">
                                <Control DockPanel.Dock="Left" Template="{StaticResource Logo}" Width="50" Height="50" Margin="0,0,18,0" Focusable="False" />
                                <TextBlock DockPanel.Dock="Right" x:Name="GuideClock" FontSize="24" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="CouchShell" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding GuideItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Group}" FontSize="18" FontWeight="SemiBold" Foreground="#8B909A" Margin="52,22,52,10"
                                                       Visibility="{Binding Group, Converter={StaticResource CollapsedWhenNull}}" />
                                            <Button Tag="{Binding Key}" Command="{Binding Command}" Style="{StaticResource GuideButton}"
                                                    AutomationProperties.Name="{Binding Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Left and right change the volume" FontSize="19" Foreground="#8B909A" Margin="52,30,52,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>
            </Border>
        </Grid>

        <!-- Confirmation step for power actions. Outside the main Viewbox, so the dimming also
             covers any bars on a screen that isn't 16:9. -->
        <Grid Visibility="{Binding IsConfirmOpen, Converter={StaticResource VisibleWhenTrue}}">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="80,56"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ConfirmText}" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,40" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Yes" Tag="confirm:yes" Command="{Binding ConfirmYesCommand}" Style="{StaticResource DialogButton}" />
                                <Button Content="No" Tag="confirm:no" Command="{Binding ConfirmNoCommand}" Style="{StaticResource DialogButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Startup animation: the logo grows in, a green ring spreads out, then it all fades away to
             reveal the home screen. Clicks and focus pass through it. -->
        <Grid x:Name="Splash" Background="#0D0E11" IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SplashLogo" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                            <DoubleAnimation Storyboard.TargetName="SplashScale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashScale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashRing" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.25" From="0.6" To="0" Duration="0:0:1.1" />
                            <DoubleAnimation Storyboard.TargetName="SplashRingScale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.25" From="0.8" To="3" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashRingScale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.25" From="0.8" To="3" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashName" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5" From="0" To="1" Duration="0:0:0.5" />
                            <DoubleAnimation Storyboard.TargetName="SplashNameMove" Storyboard.TargetProperty="Y" BeginTime="0:0:0.5" From="16" To="0" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Splash" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.9" To="0" Duration="0:0:0.45" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Splash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:2.35" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Ellipse x:Name="SplashRing" Width="220" Height="220" Stroke="#3DBA3D" StrokeThickness="3" Opacity="0"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="SplashRingScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Control x:Name="SplashLogo" Template="{StaticResource Logo}" Width="170" Height="170" Opacity="0" Focusable="False" RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="SplashScale" />
                            </Control.RenderTransform>
                        </Control>
                        <TextBlock x:Name="SplashName" Text="CouchShell" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,28,0,0" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="SplashNameMove" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>

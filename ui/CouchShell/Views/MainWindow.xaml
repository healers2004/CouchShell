<!-- Borderless fullscreen window: no title bar, can't be resized, fills the screen. -->
<Window x:Class="CouchShell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CouchShell.Views"
        xmlns:vm="clr-namespace:CouchShell.ViewModels"
        Title="CouchShell"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Background="#0B0D12"
        Foreground="#F4F5F8">

    <!-- Arrow keys are handled in code, on the same path as the controller. Enter is handled by the
         focused button itself. These work wherever focus is. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding VolumeDownCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Key="M" Command="{Binding MuteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <views:InverseBooleanConverter x:Key="Inverse" />
        <views:NullToCollapsedConverter x:Key="CollapsedWhenNull" />

        <!-- Colours. Everything below uses these, so the look can change in one place. -->
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A6ABBA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191C24" />
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#2A2E3A" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFC86B" />
        <Color x:Key="BackgroundColor">#0B0D12</Color>
        <Color x:Key="BackgroundClearColor">#000B0D12</Color>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- The same shapes as tools/make-icon.ps1. -->
        <ControlTemplate x:Key="Logo">
            <Viewbox>
                        <Canvas Width="256" Height="256">
                            <Rectangle Width="256" Height="256" RadiusX="56" RadiusY="56">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6D7CFF" Offset="0" />
                                        <GradientStop Color="#3A2BB8" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Canvas.Left="66" Canvas.Top="70" Width="124" Height="72" RadiusX="20" RadiusY="20" Fill="#C9D0FF" />
                            <Rectangle Canvas.Left="72" Canvas.Top="130" Width="112" Height="48" RadiusX="10" RadiusY="10" Fill="White" />
                            <Rectangle Canvas.Left="38" Canvas.Top="112" Width="46" Height="72" RadiusX="20" RadiusY="20" Fill="White" />
                            <Rectangle Canvas.Left="172" Canvas.Top="112" Width="46" Height="72" RadiusX="20" RadiusY="20" Fill="White" />
                            <Rectangle Canvas.Left="60" Canvas.Top="184" Width="18" Height="20" RadiusX="4" RadiusY="4" Fill="White" />
                            <Rectangle Canvas.Left="178" Canvas.Top="184" Width="18" Height="20" RadiusX="4" RadiusY="4" Fill="White" />
                        </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- Fades content in when a screen opens or the preview changes. -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MotionDuration}" />
        </Storyboard>

        <!-- A tab or dialog button. Focus is solid white, readable from across the room. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="26" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#0B0D12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A key on the Search screen's keyboard. -->
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F4F5F8" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" Background="#CC2A2E3A" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#0B0D12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tile: picture on top, title underneath. On focus the picture grows and gains a white
             ring, and the title brightens. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,28,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="360">
                            <Border x:Name="Card" Height="202" CornerRadius="14" Background="{Binding Accent}"
                                    BorderThickness="4" BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Scale" />
                                </Border.RenderTransform>
                                <ContentPresenter />
                            </Border>
                            <TextBlock x:Name="Caption" Text="{Binding Title}" FontSize="26" Margin="4,16,4,0"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="21" Margin="4,2,4,0" Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Subtitle, Converter={StaticResource CollapsedWhenNull}}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A8C4FF" BlurRadius="44" ShadowDepth="0" Opacity="0.75" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Caption" Property="Foreground" Value="White" />
                                <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionDuration}" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionDuration}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button hints along the bottom. -->
        <Style x:Key="HintBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="28,0,10,0" />
        </Style>
        <Style x:Key="HintBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The focused tile's own colour, as a soft glow from the top right. -->
        <Rectangle Fill="{Binding FocusedTile.Accent}" Opacity="0.55">
            <Rectangle.OpacityMask>
                <RadialGradientBrush Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- The focused game's artwork fills the top of the screen, fading into the background so
             text stays readable over any picture. -->
        <Grid VerticalAlignment="Top">
            <Image Stretch="UniformToFill" Height="760" VerticalAlignment="Top" Opacity="0.75"
                   Source="{Binding FocusedTile.Backdrop, TargetNullValue={x:Null}, NotifyOnTargetUpdated=True}">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <Rectangle Height="760" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
                        <GradientStop Color="{StaticResource BackgroundClearColor}" Offset="0.7" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="760" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#990B0D12" Offset="0" />
                        <GradientStop Color="{StaticResource BackgroundClearColor}" Offset="0.3" />
                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Layout is designed on a fixed 1920x1080 canvas; Viewbox scales it to fit
             any resolution (1080p, 4K) and any Windows scaling setting. -->
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="214" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: logo, tabs, then clock and connection status. Disabled behind the confirm
                     dialog, so focus can't leave it. -->
                <DockPanel Margin="64,36,64,0" IsEnabled="{Binding IsConfirmOpen, Converter={StaticResource Inverse}}">
                    <Control DockPanel.Dock="Left" Template="{StaticResource Logo}" Width="48" Height="48" Margin="0,0,28,0" VerticalAlignment="Center" Focusable="False" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF7B7B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CD9A0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="22" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Disconnected" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="Connected" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="Clock" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#59000000" CornerRadius="34" Padding="8,6,8,0"
                            BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,4,0">
                                    <Button x:Name="Tab" Tag="{Binding FocusKey}" Command="{Binding Command}" Content="{Binding Name}"
                                            Style="{StaticResource PillButton}" AutomationProperties.Name="{Binding Name}" />
                                    <!-- Marks the open screen's tab by more than colour alone. -->
                                    <Rectangle x:Name="CurrentBar" Height="4" Width="36" RadiusX="2" RadiusY="2" Margin="0,5,0,0"
                                               Fill="White" Visibility="Hidden" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="CurrentBar" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Tab" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                </DockPanel>

                <!-- Preview: what the focused tile is. -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="68,0,64,22">
                    <TextBlock Text="{Binding FocusedTile.Title, NotifyOnTargetUpdated=True}" FontSize="68" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.8" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MotionDuration}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-24" To="0" Duration="{StaticResource MotionDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                        <Border Background="#F2FFFFFF" CornerRadius="16" Padding="16,3" Margin="0,0,16,0" VerticalAlignment="Center"
                                Visibility="{Binding FocusedTile.ActionLabel, Converter={StaticResource CollapsedWhenNull}}">
                            <TextBlock Text="{Binding FocusedTile.ActionLabel}" FontSize="22" FontWeight="SemiBold" Foreground="#0B0D12" />
                        </Border>
                        <TextBlock Text="{Binding FocusedTile.Description}" FontSize="26" Foreground="#D5D8E2" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Rows of tiles. The vertical scroller moves between rows; each row scrolls sideways
                     on its own. Margins leave room for the focused tile's growth. -->
                <!-- Tiles fade out at the bottom instead of being cut off. A mask stretches over what its
                     element draws, so this Grid's background is what makes it span the whole area. -->
                <Grid Grid.Row="2" Background="Transparent">
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.94" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                <ScrollViewer x:Name="TileScroller" Focusable="False" VerticalScrollBarVisibility="Hidden"
                              IsEnabled="{Binding IsConfirmOpen, Converter={StaticResource Inverse}}">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" RequestBringIntoView="OnTileBringIntoView">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,24">
                                    <StackPanel.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                        </EventTrigger>
                                    </StackPanel.Triggers>
                                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" Margin="68,0,0,4" />
                                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="64,14,64,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding Key}" Command="{Binding Command}" Style="{StaticResource TileButton}"
                                                            AutomationProperties.Name="{Binding Title}">
                                                        <Grid>
                                                            <!-- The tile is a fixed size, so its corners can be clipped directly. -->
                                                            <Grid.Clip>
                                                                <RectangleGeometry Rect="0,0,352,194" RadiusX="10" RadiusY="10" />
                                                            </Grid.Clip>
                                                            <Image Source="{Binding Image, TargetNullValue={x:Null}}" Stretch="UniformToFill"
                                                                   Visibility="{Binding Image, Converter={StaticResource CollapsedWhenNull}}" />
                                                            <Image Source="{Binding IconPath, TargetNullValue={x:Null}}" Width="104" Height="104"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource CollapsedWhenNull}}" />
                                                            <Path Data="{Binding LogoPath}" Fill="{Binding LogoColor}" Stretch="Uniform" Width="104" Height="104"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding LogoPath, Converter={StaticResource CollapsedWhenNull}}" />
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="64" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Glyph, Converter={StaticResource CollapsedWhenNull}}" />
                                                            <TextBlock Text="{Binding Monogram}" FontSize="92" FontWeight="SemiBold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding Monogram, Converter={StaticResource CollapsedWhenNull}}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>

                <!-- Shown instead of tiles when a screen has none. -->
                <TextBlock Grid.Row="2" Text="{Binding EmptyText}" FontSize="36" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Footer: a message on the left when there is one, button hints on the right. -->
                <!-- The Search screen's keyboard. Its keys are ordinary focusable buttons, so moving
                     between them and the results works like moving between tiles. -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding SearchKeys}" Focusable="False" HorizontalAlignment="Center" Margin="0,0,0,12"
                              Visibility="{Binding IsSearchScreen, Converter={StaticResource VisibleWhenTrue}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" Focusable="False" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding FocusKey}" Command="{Binding Command}" Content="{Binding Label}" Width="{Binding Width}"
                                                Style="{StaticResource KeyButton}" AutomationProperties.Name="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Grid.Row="4" Margin="64,4,64,32" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource HintBadge}" Background="#2E8B57">
                            <TextBlock Text="A" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Select" Style="{StaticResource HintLabel}" />
                        <Border Style="{StaticResource HintBadge}" Background="#C0392B">
                            <TextBlock Text="B" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Back" Style="{StaticResource HintLabel}" />
                        <Border Style="{StaticResource HintBadge}">
                            <TextBlock Text="LB / RB" Style="{StaticResource HintBadgeText}" />
                        </Border>
                        <TextBlock Text="Volume" Style="{StaticResource HintLabel}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22,10"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Visibility="{Binding Message, Converter={StaticResource CollapsedWhenNull}}">
                        <TextBlock Text="{Binding Message}" FontSize="24" TextWrapping="Wrap" />
                    </Border>
                </DockPanel>

                <!-- Volume overlay. -->
                <Border Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110"
                        Background="#F2191C24" CornerRadius="20" Padding="36,24" Width="680"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                        Visibility="{Binding IsVolumeVisible, Converter={StaticResource VisibleWhenTrue}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="38" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static vm:Glyphs.VolumeUp}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="{x:Static vm:Glyphs.Mute}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" FontSize="32" FontWeight="SemiBold" Margin="24,0,0,0" Width="110" TextAlignment="Right" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding VolumePercent, StringFormat={}{0}%}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="Muted" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=OneWay}" Height="10" VerticalAlignment="Center"
                                     Foreground="White" Background="{StaticResource SubtleSurfaceBrush}" BorderThickness="0" />
                    </DockPanel>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Confirmation step for power actions. Outside the main Viewbox, so the dimming also
             covers any bars on a screen that isn't 16:9. -->
        <Grid Background="#D905060A" Visibility="{Binding IsConfirmOpen, Converter={StaticResource VisibleWhenTrue}}">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}" CornerRadius="24" Padding="80,56"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ConfirmText}" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,40" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Yes" Tag="confirm:yes" Command="{Binding ConfirmYesCommand}" Style="{StaticResource PillButton}"
                                        Width="220" Margin="12,0" FontSize="32" />
                                <Button Content="No" Tag="confirm:no" Command="{Binding ConfirmNoCommand}" Style="{StaticResource PillButton}"
                                        Width="220" Margin="12,0" FontSize="32" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Startup animation: the logo springs in, a ring spreads out, then it all fades away to
             reveal the home screen. Clicks and focus pass through it. -->
        <Grid x:Name="Splash" Background="#0B0D12" IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SplashLogo" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                            <DoubleAnimation Storyboard.TargetName="SplashScale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1" Duration="0:0:0.75">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.55" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashScale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1" Duration="0:0:0.75">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.55" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashRing" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.25" From="0.7" To="0" Duration="0:0:1.1" />
                            <DoubleAnimation Storyboard.TargetName="SplashRingScale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.25" From="0.8" To="3" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashRingScale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.25" From="0.8" To="3" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashName" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5" From="0" To="1" Duration="0:0:0.5" />
                            <DoubleAnimation Storyboard.TargetName="SplashNameMove" Storyboard.TargetProperty="Y" BeginTime="0:0:0.5" From="16" To="0" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Splash" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.9" To="0" Duration="0:0:0.45" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Splash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:2.35" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush RadiusX="0.5" RadiusY="0.6">
                        <GradientStop Color="#26406CFF" Offset="0" />
                        <GradientStop Color="#000B0D12" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Ellipse x:Name="SplashRing" Width="220" Height="220" Stroke="#8C98FF" StrokeThickness="3" Opacity="0"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="SplashRingScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Control x:Name="SplashLogo" Template="{StaticResource Logo}" Width="170" Height="170" Opacity="0" Focusable="False" RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="SplashScale" />
                            </Control.RenderTransform>
                        </Control>
                        <TextBlock x:Name="SplashName" Text="CouchShell" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,28,0,0" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="SplashNameMove" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>

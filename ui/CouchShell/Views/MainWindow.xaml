<!-- Borderless fullscreen window: no title bar, can't be resized, fills the screen. -->
<Window x:Class="CouchShell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CouchShell.ViewModels"
        Title="CouchShell"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#101018">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Escape works wherever focus is. Enter is handled by the focused tab button itself. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding GoHomeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Tab button: plain text, with a solid highlight when it has keyboard focus (readable from the couch). -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B0B0C0" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <!-- Hide WPF's default dotted focus box; the trigger below is the focus indicator. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Highlight" Background="Transparent" CornerRadius="12" Padding="32,16">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="#3A6FF7" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Layout is designed on a fixed 1920x1080 canvas; Viewbox scales it to fit
         any resolution (1080p, 4K) and any Windows scaling setting. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- One button per screen. Left/Right arrows move focus between them (wrapping at the ends). -->
            <ItemsControl ItemsSource="{Binding Screens}"
                          Margin="80,60"
                          Focusable="False"
                          KeyboardNavigation.DirectionalNavigation="Cycle">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- {Binding} is the screen name; the command lives on the window's view model. -->
                        <Button Content="{Binding}"
                                Command="{Binding DataContext.OpenScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource TabButton}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Placeholder content: the name of the open screen. -->
            <TextBlock Grid.Row="1"
                       Text="{Binding CurrentScreen}"
                       FontSize="96"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Viewbox>
</Window>

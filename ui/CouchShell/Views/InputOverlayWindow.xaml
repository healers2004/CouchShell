<!-- Floats over a running web app without ever taking focus, so keys keep going to the site.
     Mouse clicks pass straight through it too (see the code-behind). -->
<Window x:Class="CouchShell.Views.InputOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CouchShell controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>

    <!-- Designed on the same 1920x1080 canvas as the main window. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Background="#F517191D"
                    CornerRadius="6" Padding="28,16" BorderBrush="#30333B" BorderThickness="1"
                    Visibility="{Binding ShowHint, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel Orientation="Horizontal">
                    <!-- Turns while a launcher is up, so it's clear the game is still on its way. -->
                    <Ellipse Width="26" Height="26" StrokeThickness="4" Margin="0,0,18,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding IsWaiting, Converter={StaticResource VisibleWhenTrue}}">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3DBA3D" Offset="0" />
                                <GradientStop Color="#3DBA3D" Offset="0.5" />
                                <GradientStop Color="#3A3E46" Offset="0.5" />
                                <GradientStop Color="#3A3E46" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Spin" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360"
                                                         Duration="0:0:1" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding Hint}" FontSize="22" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48" Background="#F517191D"
                    CornerRadius="6" Padding="32" BorderBrush="#30333B" BorderThickness="1"
                    Visibility="{Binding IsKeyboardVisible, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Key" Height="76" MinWidth="88" Margin="5" CornerRadius="4" Background="#262930">
                                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="32" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsWide}" Value="True">
                                                    <Setter TargetName="Key" Property="MinWidth" Value="176" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Key" Property="Background" Value="White" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="#0D0E11" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="D-pad: move    A: type    B: delete    X: space    Y: shift    Start: close" FontSize="24"
                               Foreground="#A4A9B3" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</Window>
